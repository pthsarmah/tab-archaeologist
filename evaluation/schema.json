{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tab Archaeologist evaluation session",
  "type": "object",
  "required": ["name", "tabs", "truth"],
  "properties": {
    "name": { "type": "string" },
    "notes": { "type": "string" },
    "tabs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    }
  }
}
