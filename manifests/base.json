{
  "manifest_version": 3,
  "name": "Tab Archaeologist (Normal)",
  "description": "Suggests topic-based groups for open tabs. Local analysis only; browser groups are created only on explicit request.",
  "version": "0.1.0",
  "permissions": ["tabs"],
  "action": {
    "default_title": "Tab Archaeologist",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
